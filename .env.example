# Copy to `.env` and fill in. Nothing here is a real credential.
#
#   cp .env.example .env
#
# The two required values are enough to run the whole site locally with the
# demo dataset. Everything below them is for deployment and can stay unset.

# --- Required ---------------------------------------------------------------

# Your own Postgres database. Neon's free tier works and is what the site uses
# in production, but any Postgres 14+ will do, including one in Docker.
#
# Use a database nobody else is working in. `pnpm payload migrate` writes
# schema, and `pnpm seed:demo` writes content.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Signs login sessions. Any long random string; generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# --- Creating the first admin user ------------------------------------------
# Read by `pnpm create:admin`. The Users collection does not allow sign-ups,
# so this is how the first account is made.
BACKUP_ADMIN_EMAIL=you@example.com
BACKUP_ADMIN_PASSWORD=

# --- Optional: file storage --------------------------------------------------
# Leave USE_S3_STORAGE unset and uploads are written to local disk, which is
# what you want for local work - the demo seed's images included.
#
# Set it to `true` only with a real bucket. It is not tied to NODE_ENV, so a
# local production build still uses local disk unless you turn it on here.
# USE_S3_STORAGE=true
# S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
# S3_REGION=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_BUCKET=

# Serves uploads from the storage CDN instead of streaming them through the
# app. Only takes effect when USE_S3_STORAGE is true, because otherwise the
# files are on local disk and the CDN does not have them.
# NEXT_PUBLIC_SUPABASE_MEDIA_URL=https://<project-ref>.supabase.co/storage/v1/object/public/media

# --- Optional: deployment ----------------------------------------------------
# The canonical domain, used for canonical URLs, the sitemap and OG tags.
# Unset locally is fine - it falls back to localhost.
# NEXT_PUBLIC_SITE_URL=https://www.embedclub.org

# Search Console's HTML tag verification token, if you verify a property that
# way. Absent means the tag is simply not rendered.
# GOOGLE_SITE_VERIFICATION=
